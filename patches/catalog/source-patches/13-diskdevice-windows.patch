+static int DiskWinOpen(const char *path, int flags) {
+    return _open(path, flags | _O_BINARY);
+}
+
+static int DiskWinClose(int fd) {
+    return _close(fd);
+}
+
+static ssize_t DiskWinPRead(int fd, void *buf, size_t count, long long offset) {
+    long long cur = _lseeki64(fd, 0, SEEK_CUR);
+    if (_lseeki64(fd, offset, SEEK_SET) < 0) {
+        return -1;
+    }
+    ssize_t total = 0;
+    while ((size_t)total < count) {
+        int got = _read(fd, (char*)buf + total, (unsigned int)(count - (size_t)total));
+        if (got <= 0) {
+            break;
+        }
+        total += got;
+    }
+    _lseeki64(fd, cur, SEEK_SET);
+    return total;
+}
+
+static void *DiskWinMmap(void *addr, size_t length, int prot, int flags, int fd, long long offset) {
+    HANDLE h = (HANDLE)_get_osfhandle(fd);
+    if (h == INVALID_HANDLE_VALUE) {
+        return (void*)-1;
+    }
+    HANDLE mapping = CreateFileMappingA(h, nullptr, PAGE_READONLY, 0, 0, nullptr);
+    if (mapping == nullptr) {
+        return (void*)-1;
+    }
+    void *p = MapViewOfFile(mapping, FILE_MAP_READ, (DWORD)((unsigned long long)offset >> 32), (DWORD)offset, length);
+    CloseHandle(mapping);
+    return p == nullptr ? (void*)-1 : p;
+}
+
+static int DiskWinMunmap(void *addr, size_t length) {
+    return UnmapViewOfFile(addr) ? 0 : -1;
+}

+    // Windows 上直接 IO 路径不会启用；为保证 free() 兼容，按普通 malloc 分配
+    void *p = malloc(size == 0 ? 1 : size);
+    if (p == nullptr) {
+        return ENOMEM;
+    }
+    *memptr = p;
+    return 0;
+}

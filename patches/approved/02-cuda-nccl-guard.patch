+namespace {
+    size_t FastllmNcclStubDataTypeBytes(int dataType) {
+        if (dataType == fastllm::DataType::FLOAT32) {
+            return sizeof(float);
+        } else if (dataType == fastllm::DataType::FLOAT16 || dataType == fastllm::DataType::BFLOAT16) {
+            return sizeof(uint16_t);
+        }
+        return 0;
+    }
+}
